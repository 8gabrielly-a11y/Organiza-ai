{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "sync_token": {
      "type": "string",
      "description": "Token de sincroniza\u00e7\u00e3o incremental do Google Calendar"
    },
    "provider": {
      "type": "string",
      "default": "googlecalendar"
    }
  },
  "required": [
    "sync_token"
  ]
}